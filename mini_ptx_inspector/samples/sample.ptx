.version 7.0
.target sm_75
.address_size 64

.visible .entry vector_add()
{
    .reg .b32 %r<4>;
    .reg .b64 %rd<3>;
    .reg .pred %p<2>;

    // Load two values, add them, and store the result.
    ld.global.u32 %r1, [%rd1];
    ld.global.u32 %r2, [%rd2];
    add.u32 %r3, %r1, %r2;
    setp.eq.u32 %p1, %r3, 0;
    @%p1 bra DONE;
    st.global.u32 [%rd2], %r3;
DONE:
    ret;
}
